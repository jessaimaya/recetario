# Build-time: where the app sends natural-language questions. Leave unset and the question box does not appear.
VITE_ASK_URL=/api/ask

# Netlify environment (never in the repo), read by netlify/functions/ask.mts:
# ANTHROPIC_API_KEY=
# ASK_ENABLED=true        off switch: anything else answers 503
# ASK_ORIGIN=https://your-site.example   only this origin may call it
# ASK_PER_HOUR=20         questions per visitor per hour
# ASK_DAILY_USD=1         stop for the day once this much has been spent
