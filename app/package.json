{
  "name": "recetario-app",
  "version": "0.1.0",
  "private": true,
  "description": "Offline recipe finder over a recetario database",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.14.0",
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "preact": "^11.0.1"
  }
}
